@@ -0,0 +1,40 @@
+#pragma once
+/*
+ * 表情音效：换表情时播一个 0.3～1 秒的短音效（sfx_<表情名>.ogg，放在本目录即自动打包）。
+ *
+ * 模式（NVS 保存，MCP 工具 self.dog.set_sound_effects 修改）：
+ *   0 关闭
+ *   1 只在空闲时播（默认）：噜噜说话、聆听时不播，免得盖住说话或被麦克风收进去
+ *   2 总是播：对话中切表情也播，会排在语音前面
+ * 同一个表情不重复播；动作 JSON 里的 "sound" 字段可以指定别的音效，"none" 表示这次不出声。
+ */
+
+#include "display/emote_display.h"
+
+#include <string>
+
+namespace lulu_sfx {
+
+enum Mode { kOff = 0, kIdleOnly = 1, kAlways = 2 };
+
+Mode mode();
+void set_mode(Mode m);
+
+// 按名字播放（表情名或音效名，如 "happy"、"woof"），没有这个音效返回 false
+bool play(const char* name, bool force = false);
+// 下一次换表情时不播（动作自带音效时用）
+void skip_next();
+// 换表情时由 LuluDisplay 调用
+void on_emotion(const char* emotion);
+
+}  // namespace lulu_sfx
+
+class LuluDisplay : public emote::EmoteDisplay {
+public:
+    using emote::EmoteDisplay::EmoteDisplay;
+
+    void SetEmotion(const char* emotion) override {
+        emote::EmoteDisplay::SetEmotion(emotion);
+        lulu_sfx::on_emotion(emotion);
+    }
+};
