+static void ble_kf_reply(const uint8_t* payload, size_t len) {
+    if (len > 240) return;
+    uint8_t frame[256];
+    frame[0] = 0x55;
+    frame[1] = 0x00;
+    frame[2] = (uint8_t)(len + 7);
+    frame[3] = KF_LINK_BLE_ORDER_REPLY;
+    memcpy(&frame[4], payload, len);
+    uint32_t s = frame[2] + frame[3];
+    for (size_t j = 0; j < len; j++) s += payload[j];
+    frame[4 + len] = (uint8_t)(0xFF - (s & 0xFF));
+    frame[5 + len] = 0x00;
+    frame[6 + len] = 0xAA;
+    ble_remote_send(frame, len + 7);
+}
