 #include <mutex>
+#include <cstdint>
 
 class NoAudioCodec : public AudioCodec {
 protected:
     std::mutex data_if_mutex_;
 
+    // ---- 软件回采参考（设备端回声消除用）----
+    // 没有硬件回采通道时，把送给喇叭的数据按“预计播放时间”记在一条时间轴上，
+    // 读麦克风时取同一时刻的数据作为参考通道，输出 [麦克风, 参考] 交错两通道。
+    std::mutex ref_mutex_;
+    bool soft_ref_ = false;
+    int16_t* ref_ring_ = nullptr;     // 按 16k 采样点编号的环形时间轴
+    uint32_t* ref_tag_ = nullptr;     // 每个格子对应的绝对采样编号，用来判断是否过期
+    uint32_t ref_next_k_ = 0;         // 下一段喇叭数据的预计开始编号
+    int ref_lead_samples_ = 0;        // 参考比麦克风提前多少个采样点（可为负）
+    std::vector<int16_t> mic_tmp_;
+    void EnableSoftwareReference(int lead_ms);
+    uint32_t NowK() const;
+    virtual void OutputData(std::vector<int16_t>& data) override;
+    virtual bool InputData(std::vector<int16_t>& data) override;
+
     virtual int Write(const int16_t* data, int samples) override;
     virtual int Read(int16_t* dest, int samples) override;
     virtual void EnableInput(bool enable) override;
