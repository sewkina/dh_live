diff --git a/main/audio/codecs/no_audio_codec.cc b/main/audio/codecs/no_audio_codec.cc
index 6d73e68..989bf1c 100644
--- a/main/audio/codecs/no_audio_codec.cc
+++ b/main/audio/codecs/no_audio_codec.cc
@@ -3,10 +3,82 @@
 #include <esp_log.h>
 #include <cmath>
 #include <cstring>
+#include <esp_timer.h>
+#include <esp_heap_caps.h>
+#include <sdkconfig.h>
+
+#define REF_RING_SAMPLES 16384  // 约 1 秒 @16k
 
 #define TAG "NoAudioCodec"
 
+void NoAudioCodec::EnableSoftwareReference(int lead_ms) {
+    if (input_sample_rate_ != 16000 || output_sample_rate_ != 16000) {
+        ESP_LOGE(TAG, "Software AEC reference needs 16k in/out (in=%d out=%d)", input_sample_rate_, output_sample_rate_);
+        return;
+    }
+    ref_ring_ = (int16_t*)heap_caps_calloc(REF_RING_SAMPLES, sizeof(int16_t), MALLOC_CAP_SPIRAM);
+    ref_tag_ = (uint32_t*)heap_caps_calloc(REF_RING_SAMPLES, sizeof(uint32_t), MALLOC_CAP_SPIRAM);
+    if (ref_ring_ == nullptr || ref_tag_ == nullptr) {
+        ESP_LOGE(TAG, "Software AEC reference: no memory");
+        return;
+    }
+    ref_lead_samples_ = lead_ms * 16;
+    soft_ref_ = true;
+    input_reference_ = true;
+    input_channels_ = 2;
+    ESP_LOGI(TAG, "Software AEC reference enabled, lead %d ms", lead_ms);
+}
+
+uint32_t NoAudioCodec::NowK() const {
+    return (uint32_t)(esp_timer_get_time() * 16 / 1000);  // 16k 采样点编号
+}
+
+void NoAudioCodec::OutputData(std::vector<int16_t>& data) {
+    if (soft_ref_ && !data.empty()) {
+        // 在写入 DMA 之前记下时间：喇叭空闲时这段从“现在”开始播，连续播放时接在上一段后面
+        int32_t vol = output_volume_ * output_volume_;  // 0..10000，与 Write 里的平方音量曲线一致
+        std::lock_guard<std::mutex> lock(ref_mutex_);
+        uint32_t now_k = NowK();
+        uint32_t start = ((int32_t)(ref_next_k_ - now_k) > 0) ? ref_next_k_ : now_k;
+        for (size_t i = 0; i < data.size(); i++) {
+            uint32_t k = start + i;
+            int32_t v = (int32_t)data[i] * vol / 10000;
+            ref_ring_[k % REF_RING_SAMPLES] = (int16_t)v;
+            ref_tag_[k % REF_RING_SAMPLES] = k;
+        }
+        ref_next_k_ = start + data.size();
+    }
+    Write(data.data(), data.size());
+}
+
+bool NoAudioCodec::InputData(std::vector<int16_t>& data) {
+    if (!soft_ref_) {
+        return AudioCodec::InputData(data);
+    }
+    int frames = data.size() / 2;
+    mic_tmp_.resize(frames);
+    int got = Read(mic_tmp_.data(), frames);
+    if (got <= 0) {
+        return false;
+    }
+    std::lock_guard<std::mutex> lock(ref_mutex_);
+    // 这块麦克风数据大约在 [now-got, now) 录到，取同一时间段的喇叭数据作参考
+    uint32_t k0 = NowK() - got + ref_lead_samples_;
+    for (int i = 0; i < got; i++) {
+        uint32_t k = k0 + i;
+        uint32_t idx = k % REF_RING_SAMPLES;
+        data[2 * i] = mic_tmp_[i];
+        data[2 * i + 1] = (ref_tag_[idx] == k) ? ref_ring_[idx] : 0;
+    }
+    if (got < frames) {
+        data.resize(got * 2);
+    }
+    return true;
+}
+
 NoAudioCodec::~NoAudioCodec() {
+    if (ref_ring_) heap_caps_free(ref_ring_);
+    if (ref_tag_) heap_caps_free(ref_tag_);
     if (rx_handle_ != nullptr) {
         ESP_ERROR_CHECK(i2s_channel_disable(rx_handle_));
     }
